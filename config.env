# Release timing -- gohaena.com opens reservations RELEASE_DAYS_BEFORE the
# target date, at RELEASE_TIME local to RELEASE_TIMEZONE. As of this writing
# that's 30 days out at midnight HST. Adjust if the site's policy changes,
# or if you're adapting this bot for a different reservation system.
RELEASE_TIMEZONE=Pacific/Honolulu
RELEASE_DAYS_BEFORE=30
RELEASE_TIME=00:00:00

PREWARM_MINUTES_BEFORE=10
MAX_RETRY_ATTEMPTS=5
RETRY_WINDOW_SECONDS=150

# Operational Flags
DRY_RUN=false
HEADLESS=false
